ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY --chown=www-data:www-data app/app/Http/Controllers/AdminDigitalProductController.php /var/www/html/app/Http/Controllers/AdminDigitalProductController.php
