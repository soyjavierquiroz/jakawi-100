FROM php:8.4-fpm-bookworm AS tools
RUN apt-get update && apt-get install -y --no-install-recommends git libicu-dev libpq-dev libzip-dev unzip zip ca-certificates curl gnupg && docker-php-ext-install bcmath intl opcache pdo_pgsql pgsql zip
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN mkdir -p /etc/apt/keyrings && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && apt-get update && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*
WORKDIR /var/www/html
COPY app/composer.json app/composer.lock ./
RUN composer install --prefer-dist --no-interaction --no-scripts
COPY app/package.json app/package-lock.json ./
RUN npm ci
COPY app/ ./
RUN composer dump-autoload --optimize
FROM tools AS assets
RUN npm run types:check && npm run build
FROM tools AS runtime
COPY --from=assets /var/www/html/public/build ./public/build
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache storage/app/public && chown -R www-data:www-data storage bootstrap/cache
USER www-data
CMD ["php-fpm"]
FROM nginx:1.27-alpine AS web
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=assets /var/www/html/public /var/www/html/public
