APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Private JAKAWI media bucket. Use dedicated, scoped (never root) credentials.
MEDIA_DISK=minio-media
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
MEDIA_AWS_DEFAULT_REGION=us-east-1
MEDIA_AWS_BUCKET=jakawi-media
MEDIA_AWS_ENDPOINT=https://myminioback.kuruk.in
MEDIA_AWS_USE_PATH_STYLE_ENDPOINT=true

# imgproxy public delivery; KEY and SALT are url-safe base64 random values.
IMGPROXY_URL=https://img.jakawi.com
IMGPROXY_KEY=
IMGPROXY_SALT=
# Separate read-only MinIO identity consumed only by imgproxy.
IMGPROXY_AWS_ACCESS_KEY_ID=
IMGPROXY_AWS_SECRET_ACCESS_KEY=

# QR payments remain disabled until a real provider contract is implemented.
QR_PAYMENT_ENABLED=false
QR_PAYMENT_DRIVER=disabled

VITE_APP_NAME="${APP_NAME}"
